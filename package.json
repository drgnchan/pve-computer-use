{
  "name": "pve-computer-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control a Proxmox VE VM console (screenshot + mouse/keyboard) from the command line",
  "license": "MIT",
  "author": "drgnchan",
  "repository": { "type": "git", "url": "git+https://github.com/drgnchan/pve-computer-use.git" },
  "bugs": { "url": "https://github.com/drgnchan/pve-computer-use/issues" },
  "homepage": "https://github.com/drgnchan/pve-computer-use#readme",
  "keywords": ["proxmox", "pve", "vnc", "novnc", "computer-use", "remote-control", "screenshot", "automation"],
  "bin": {
    "pve-cu": "./bin/pve-cu.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "for f in src/*.js scripts/*.mjs; do node --check \"$f\" || exit 1; done && node -e \"import('./web/dist/console.bundle.js').catch(()=>{})\" && echo syntax-ok",
    "test": "node --test test/*.test.js",
    "test:ci": "node --test --test-force-exit --test-concurrency=1 test/*.test.js",
    "smoke": "node scripts/smoke-browser.mjs",
    "install-skill": "node scripts/install-skill.mjs",
    "install-skill:global": "node scripts/install-skill.mjs --global",
    "debug:rfb": "node scripts/debug-rfb.mjs",
    "mock-console": "node scripts/mock-console.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "playwright-core": "^1.58.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  }
}
